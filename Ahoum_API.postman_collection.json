								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/events/{{event_id}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"events",
								"{{event_id}}",
								""
							]
						},
						"description": "Blocked if there are active enrollments."
					},
					"response": []
				}
			]
		},
