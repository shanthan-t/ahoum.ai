	"item": [
		{
			"name": "1. Authentication",
			"description": "Signup, verify OTP, and login flows.",
			"item": [
				{
					"name": "Signup",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"seeker@example.com\",\n    \"password\": \"SecurePass123!\",\n    \"role\": \"seeker\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/accounts/signup/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"accounts",
								"signup",
								""
							]
						},
						"description": "Creates an unverified account. Check your Django console output for the 6-digit OTP."
					},
					"response": []
				},
				{
					"name": "Verify Email",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"seeker@example.com\",\n    \"otp\": \"REPLACE_ME\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/accounts/verify-email/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"accounts",
								"verify-email",
								""
							]
						},
						"description": "Replace REPLACE_ME with the 6-digit OTP printed in your local Django console."
					},
					"response": []
				},
				{
					"name": "Resend OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"seeker@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/accounts/resend-otp/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"accounts",
								"resend-otp",
								""
							]
						},
						"description": "Requires a 60-second cooldown."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"access_token\", jsonData.access);",
									"    pm.collectionVariables.set(\"refresh_token\", jsonData.refresh);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"seeker@example.com\",\n    \"password\": \"SecurePass123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/accounts/login/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"accounts",
								"login",
								""
							]
						},
						"description": "Returns JWT tokens. The test script will automatically capture `access_token` into collection variables for authenticated requests."
					},
					"response": []
				},
				{
					"name": "Token Refresh",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"access_token\", jsonData.access);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/accounts/token/refresh/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"accounts",
								"token",
								"refresh",
								""
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Events",
			"description": "Event CRUD and discovery.",
			"item": [
				{
					"name": "Create Event",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"event_id\", jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Advanced Python Workshop\",\n    \"description\": \"Deep dive into Django and concurrency.\",\n    \"language\": \"English\",\n    \"location\": \"Remote\",\n    \"starts_at\": \"2026-10-01T10:00:00Z\",\n    \"ends_at\": \"2026-10-01T14:00:00Z\",\n    \"capacity\": 10\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/events/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"events",
								""
							]
						},
						"description": "Must be authenticated as a Facilitator."
					},
					"response": []
				},
				{
					"name": "List/Search Events",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/events/?q=python&language=english",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"events",
								""
							],
							"query": [
								{
									"key": "q",
									"value": "python"
								},
								{
									"key": "language",
									"value": "english"
								},
								{
									"key": "location",
									"value": "remote",
									"disabled": true
								},
								{
									"key": "starts_after",
									"value": "2026-09-01T00:00:00Z",
									"disabled": true
								}
							]
						},
						"description": "Lists upcoming events. Supports q, location, language, starts_after, starts_before."
					},
					"response": []
				},
				{
					"name": "List My Events",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/events/mine/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"events",
								"mine",
								""
							]
						},
						"description": "Returns events created by the logged-in Facilitator with metrics."
					},
					"response": []
				},
				{
					"name": "Retrieve Event",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/events/{{event_id}}/",
							"host": [
